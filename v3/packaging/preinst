#!/bin/sh
set -eu
export PATH=/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin
[ -d /var/jb ] || { echo 'CarDash V3 requires a rootless jailbreak.' >&2; exit 1; }
[ "$(sysctl -n hw.machine)" = iPhone10,2 ] && [ "$(sysctl -n kern.osversion)" = 20G75 ] || { echo 'This native preview is verified only on iPhone 8 Plus, iOS 16.6 build 20G75. Installation stopped without changing CarDash.' >&2; exit 1; }
