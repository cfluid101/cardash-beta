#!/bin/sh
set -eu
export PATH=/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin
mkdir -p /var/jb/var/lib/cardash-v3
chown root:mobile /var/jb/var/lib/cardash-v3
chmod 750 /var/jb/var/lib/cardash-v3
printf 'CarDash V3 3.0.0 beta 4 install\n' >> /var/jb/var/lib/cardash-v3/installation.log
date -u >> /var/jb/var/lib/cardash-v3/installation.log
launchctl bootout system/com.cfluid.cardash.v3 >/dev/null 2>&1 || true
launchctl bootstrap system /var/jb/Library/LaunchDaemons/com.cfluid.cardash.v3.plist >> /var/jb/var/lib/cardash-v3/installation.log 2>&1
# Reload only the media service to load the exact-build loopback adapter.
launchctl kickstart -k system/com.apple.mediaserverd >> /var/jb/var/lib/cardash-v3/installation.log 2>&1
uicache -p /var/jb/Applications/CarDashV3.app >> /var/jb/var/lib/cardash-v3/installation.log 2>&1
printf 'V3 service registered. Open CarDash V3 to prepare and start a test. No native session starts on installation.\n' >> /var/jb/var/lib/cardash-v3/installation.log
